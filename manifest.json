{
  "manifest_version": 3,
  "name": "Statement Sweep",
  "version": "0.3.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "description": "Saves your own official statements from sites you are already signed in to. Runs in your browser and sends nothing anywhere.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "Statement Sweep"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contentSettings",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://account.optumbank.com/*",
    "https://accounts.coinbase.com/*",
    "https://app.alpaca.markets/*",
    "https://apps2.shelbycountytrustee.com/*",
    "https://card.apple.com/*",
    "https://digital.fidelity.com/*",
    "https://digital.firsthorizon.com/*",
    "https://digitalservices.fidelity.com/*",
    "https://global.americanexpress.com/*",
    "https://login.simmonsbank.com/*",
    "https://myenergycenter.com/*",
    "https://nelnet.studentaid.gov/*",
    "https://sa.www4.irs.gov/*",
    "https://secure.chase.com/*",
    "https://www.americanexpress.com/*",
    "https://www.coinbase.com/*",
    "https://www.interactivebrokers.co.uk/*",
    "https://www.interactivebrokers.com/*",
    "https://www.interactivebrokers.ie/*",
    "https://www.paypal.com/*",
    "https://www.wealthfront.com/*"
  ]
}
