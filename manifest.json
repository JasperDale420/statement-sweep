{
  "manifest_version": 3,
  "name": "Statement Sweep",
  "version": "0.4.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "description": "Saves your own official statements from sites you are already signed in to. Runs in your browser and sends nothing anywhere.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "Statement Sweep"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contentSettings",
    "debugger",
    "downloads",
    "favicon",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.interactivebrokers.co.uk/*",
    "https://*.interactivebrokers.com/*",
    "https://*.interactivebrokers.ie/*",
    "https://*.store.apple.com/*",
    "https://account.optumbank.com/*",
    "https://account.venmo.com/*",
    "https://accounts.coinbase.com/*",
    "https://app.alpaca.markets/*",
    "https://apps2.shelbycountytrustee.com/*",
    "https://card.apple.com/*",
    "https://digital.fidelity.com/*",
    "https://digital.firsthorizon.com/*",
    "https://digitalservices.fidelity.com/*",
    "https://documentinformationservice-prod-custdocmgmtweb.apps.gdrosa.redk8s.statefarm.com/*",
    "https://edocuments.statefarm.com/*",
    "https://global.americanexpress.com/*",
    "https://login.simmonsbank.com/*",
    "https://mountain-storage.s3.amazonaws.com/*",
    "https://myenergycenter.com/*",
    "https://nb.fidelity.com/*",
    "https://nelnet.studentaid.gov/*",
    "https://robinhood.com/*",
    "https://sa.www4.irs.gov/*",
    "https://secure.chase.com/*",
    "https://statements.cardless.com/*",
    "https://tax-center-forms-production.s3.amazonaws.com/*",
    "https://treasurydirect.gov/*",
    "https://workplaceservices.fidelity.com/*",
    "https://www.americanexpress.com/*",
    "https://www.apple.com/*",
    "https://www.bilt.com/*",
    "https://www.coinbase.com/*",
    "https://www.paypal.com/*",
    "https://www.spectrum.net/*",
    "https://www.treasurydirect.gov/*",
    "https://www.wealthfront.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
